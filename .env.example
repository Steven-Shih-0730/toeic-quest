# 複製成 .env.local 後填入（.env.local 不會被 commit）

# Supabase 專案網址與金鑰（Project Settings → API；新版 publishable key「sb_publishable_…」或舊版 anon key 都可以）
# 沒填時：連線對戰的按鈕會停用並顯示「尚未設定連線」，其他功能照常
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 展示用控制面板（右上角齒輪：模擬隔天、重設 demo、解鎖下一區）
# 設成 false 就隱藏；沒設定時顯示
VITE_SHOW_DEMO_PANEL=
